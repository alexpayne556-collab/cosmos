{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cosmos-savant/run_ledger/v1.0.1",
  "title": "Run Ledger Row v1.0.1",
  "description": "A resolved price run (ADR-023). run_id = sha256(ticker + date + run_scale + start_hour). All prices/dates/magnitudes are instrument-written (Section 1).",
  "type": "object",
  "required": ["run_id", "ticker", "run_scale", "start_hour", "date"],
  "properties": {
    "run_id": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "ticker": { "type": "string", "pattern": "^[A-Z.]{1,8}$" },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "run_scale": { "type": "string", "enum": ["INTRADAY", "MULTIDAY"] },
    "start_hour": { "type": "integer", "minimum": 0, "maximum": 23 },
    "parent_run_id": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "end_timestamp": { "type": ["string", "null"] },
    "run_duration": { "type": ["number", "null"], "minimum": 0 },
    "end_rule_fired": { "type": ["string", "null"] },
    "max_drawdown_during_run_pct": { "type": ["number", "null"] },
    "rel_volume_vs_20d": { "type": ["number", "null"], "minimum": 0 },
    "volume_shape": { "type": ["string", "null"], "enum": ["FRONT_LOADED", "SUSTAINED", "LATE", null] },
    "precursor": {
      "type": "object",
      "properties": {
        "float": { "type": ["number", "null"], "minimum": 0 },
        "short_interest": { "type": ["number", "null"], "minimum": 0 },
        "market_cap": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "cause_category": { "type": ["string", "null"] },
    "source_url": { "type": ["string", "null"] },
    "flagged_no_cause": { "type": "boolean" }
  },
  "additionalProperties": true
}
